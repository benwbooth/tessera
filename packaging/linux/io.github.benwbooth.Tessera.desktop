[Desktop Entry]
Type=Application
Name=Tessera
GenericName=Terminal
Comment=A terminal in the spirit of iTerm2
Exec=tessera
Icon=io.github.benwbooth.Tessera
Terminal=false
Categories=System;TerminalEmulator;
Keywords=terminal;shell;console;command;prompt;ssh;notebook;
StartupWMClass=tessera
# How other programs run a command in it (xdg-terminal-exec, file
# managers' "Run in Terminal"): `tessera -e CMD…` opens a new tab in the
# open window, or a new window when there's none.
X-TerminalArgExec=-e
X-TerminalArgDir=--working-directory=
X-TerminalArgHold=--hold
X-ExecArg=-e
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=tessera --new-window
